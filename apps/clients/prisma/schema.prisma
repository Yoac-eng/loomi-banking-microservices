generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/@generated/clients"
}

datasource db {
  provider = "postgresql"
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum AccountType {
  CHECKING
  SAVINGS
}

model User {
  id                String    @id @db.Uuid
  fullName          String    @map("full_name") @db.VarChar
  email             String    @unique @db.VarChar
  passwordHash      String?   @map("password_hash") @db.VarChar
  address           String?   @db.Text
  profilePictureUrl String?   @map("profile_picture_url") @db.VarChar
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  bankingDetails BankingDetails?
  auditLogs      ClientAuditLog[]

  @@map("users")
}

model BankingDetails {
  id            String   @id @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  agency        String   @db.VarChar
  accountNumber String   @map("account_number") @db.VarChar
  balanceCents  BigInt   @default(0) @map("balance_cents")
  accountType   AccountType @map("account_type")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([agency, accountNumber])
  @@map("banking_details")
}

model LedgerEntry {
  id            String          @id @db.Uuid
  bankingId     String          @map("banking_id") @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  amountCents   BigInt          @map("amount_cents")
  type          LedgerEntryType
  description   String?         @db.VarChar
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  bankingDetails BankingDetails @relation(fields: [bankingId], references: [id], onDelete: Cascade)

  @@map("ledger_entries")
}

model ClientAuditLog {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String   @db.VarChar
  changedFields Json    @map("changed_fields") @db.JsonB
  ipAddress    String?  @map("ip_address") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_audit_logs")
}
